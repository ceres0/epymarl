# LLM runtime configuration template
# Copy this file to `.env.llm.local` or merge the variables into your own `.env`.
# Do not commit real API keys.

# Provider selection
LLM_PROVIDER=openai_compatible

# Endpoint / auth
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=YOUR_API_KEY_HERE
LLM_MODEL=YOUR_MODEL_NAME_HERE
LLM_ORGANIZATION=
LLM_PROJECT=

# Request behavior
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4000
LLM_TIMEOUT_SECONDS=120

# Retry policy
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_SECONDS=2

# OpenAI-compatible structured output toggle
# Recommended default: false for providers with unstable response_format compatibility.
LLM_USE_RESPONSE_FORMAT=false

# Response contract
LLM_RESPONSE_FORMAT=json_object
LLM_EXPECTED_KEYS=name,description,reward_mode,subreward_keys,allowed_context_keys,strategy,metadata

# LLM generation mode
# Options: single_shot, iterative
LLM_GENERATION_MODE=iterative
LLM_GENERATION_ENABLED=true

# Prompt assembly toggles
LLM_INCLUDE_ARCHITECTURE_SUMMARY=true
LLM_INCLUDE_ENV_DESCRIPTOR=true
LLM_INCLUDE_REWARD_SCHEMA_RULES=true
LLM_INCLUDE_PREVIOUS_REWARD_CODE=true
LLM_INCLUDE_PROCESS_FEEDBACK=true
LLM_INCLUDE_TRAJECTORY_FEEDBACK=true
LLM_INCLUDE_PREFERENCE_FEEDBACK=true

# Artifact policy
LLM_OUTPUT_SPEC_ID_PREFIX=smac_team_battle_llm
LLM_OUTPUT_NAME_PREFIX=smac_team_battle_llm
LLM_SAVE_RAW_PROMPT=true
LLM_SAVE_RAW_RESPONSE=true
LLM_SAVE_PARSED_SPEC=true

# Validation gates before training
LLM_REQUIRE_SCHEMA_VALIDATION=true
LLM_REQUIRE_EXECUTOR_VALIDATION=true
LLM_REQUIRE_TPE_GATE=true

# Local paths
LLM_LOCAL_RUNTIME_ENV=config/llm/.env.llm.local
LLM_GENERATED_SPEC_DIR=./epymarl/results/llm/generated_specs
